import requests
import psycopg2
from flask import Flask, request, jsonify

app = Flask(__name__)

class CPAAgent:
    def __init__(self):
        self.ofertas = []
        self.leads = []

    def cargar_ofertas(self):
        # Simulación de ofertas CPA
        self.ofertas = [
            {"id": 1, "nombre": "Oferta Fitness", "payout": 25},
            {"id": 2, "nombre": "Oferta Nutrición", "payout": 30},
        ]
        return self.ofertas

    def registrar_lead(self, cliente):
        self.leads.append(cliente)
        return {"status": "ok", "lead": cliente}

    def optimizar_trafico(self):
        if self.leads:
            return {"msg": f"Optimizando campañas para {len(self.leads)} leads..."}
        else:
            return {"msg": "No hay leads aún para optimizar."}

agente = CPAAgent()

@app.route("/ofertas", methods=["GET"])
def ofertas():
    return jsonify(agente.cargar_ofertas())

@app.route("/lead", methods=["POST"])
def lead():
    data = request.json
    return jsonify(agente.registrar_lead(data.get("email")))

@app.route("/optimizar", methods=["GET"])
def optimizar():
    return jsonify(agente.optimizar_trafico())

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
