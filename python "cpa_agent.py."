import os
import psycopg2
from flask import Flask, request, jsonify

app = Flask(__name__)

# Función para conectar a la base de datos con manejo de errores
def get_db_connection():
    try:
        # Railway usa la variable DATABASE_URL que configuramos
        conn = psycopg2.connect(os.getenv('DATABASE_URL'))
        return conn
    except Exception as e:
        print(f"Error conectando a la DB: {e}")
        return None

@app.route('/')
def home():
    return "CPA Agent is Active and Running!"

@app.route('/track', methods=['POST'])
def track_lead():
    data = request.json
    if not data or 'email' not in data:
        return jsonify({"status": "error", "message": "Falta el email"}), 400
    
    email = data.get('email')
    
    conn = get_db_connection()
    if conn is None:
        return jsonify({"status": "error", "message": "Error de base de datos"}), 500
        
    try:
        cur = conn.cursor()
        # Insertamos el lead en la tabla que creamos
        cur.execute('INSERT INTO leads (email) VALUES (%s)', (email,))
        conn.commit()
        cur.close()
        conn.close()
        return jsonify({"status": "success", "message": "Lead guardado correctamente"}), 200
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500

if __name__ == "__main__":
    # Railway asigna el puerto automáticamente
    port = int(os.environ.get("PORT", 8080))
    app.run(host='0.0.0.0', port=port)
