import os
import psycopg2
from flask import Flask, request, jsonify

app = Flask(__name__)

# Configuración de la base de datos usando variables de entorno de Railway
def get_db_connection():
    # Railway proporciona automáticamente la variable DATABASE_URL si conectas un servicio de Postgres
    conn = psycopg2.connect(os.getenv('DATABASE_URL'))
    return conn

@app.route('/')
def home():
    return "CPA Agent is running!"

@app.route('/track', methods=['POST'])
def track_lead():
    data = request.json
    # Ejemplo: Procesar un lead de tu campaña de CPA
    email = data.get('email')
    
    conn = get_db_connection()
    cur = conn.cursor()
    # Asegúrate de tener creada una tabla 'leads' en tu base de datos
    cur.execute('INSERT INTO leads (email) VALUES (%s)', (email,))
    conn.commit()
    cur.close()
    conn.close()
    
    return jsonify({"status": "success", "message": "Lead guardado"}), 201

if __name__ == "__main__":
    # Railway requiere que uses el puerto definido por la variable de entorno PORT
    port = int(os.environ.get("PORT", 5000))
    app.run(host='0.0.0.0', port=port)
